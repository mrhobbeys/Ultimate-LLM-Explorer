# ============================================================================
#  Pi Discord Bot — configuration
#  Copy to .env (the installer's wizard does this for you). Every value here is
#  a default; uncomment and change what you need. Per-SERVER settings (moderation
#  vibe, log channel, admin role, …) are set live in Discord with `!set` / `!setup`.
# ============================================================================

# ---- Required --------------------------------------------------------------
DISCORD_TOKEN=
BOT_PREFIX=!
# Your Discord user ID(s), space- or comma-separated (enable Developer Mode to copy).
BOT_OWNER_IDS=

# ---- Storage (point at USB/SSD to spare the SD card) -----------------------
# Everything the bot writes lives under here (db, status file, backups).
BOT_DATA_DIR=data
# Or override individually:
# BOT_DB_PATH=data/bot.db
# BOT_STATUS_FILE=data/status.json
# BOT_BACKUP_DIR=data/backups

# ---- Heavy features (off by default on small hardware) ---------------------
# NLTK/VADER sentiment. Leave false on a Pi 1/Zero.
BOT_ENABLE_NLTK=false
# Path to your own newline-delimited profanity list (extends the small built-in).
BOT_PROFANITY_WORDLIST=

# ---- Moderation ------------------------------------------------------------
MOD_ENABLED=true
# off | shadow | approve | armed   (approve = DM the owner before kicks/bans)
MOD_MODE=approve
MOD_APPROVAL_TIMEOUT=900
MOD_PROFANITY_ACTION=delete
MOD_LLM_ESCALATION=true
# suspicion routing: < low = ignore, >= high = act, between = ask the LLM
MOD_SUSPICION_LOW=0.25
MOD_SUSPICION_HIGH=0.75
MOD_LLM_DELETE_SEVERITY=0.6
MOD_LLM_TIMEOUT_SEVERITY=0.8
MOD_LLM_BAN_SEVERITY=0.95
MOD_LLM_TIMEOUT_SECONDS=600
MOD_MIN_ESCALATION_LEN=12
MOD_VERDICT_CACHE_SIZE=512

# ---- Learned spam filter (Naive Bayes — learns what spam "feels like") -----
BAYES_ENABLED=true
# act (delete) at/above this P(spam)
BAYES_SPAM_THRESHOLD=0.92
# force an LLM second opinion at/above this P(spam)
BAYES_ESCALATE_THRESHOLD=0.7
# stays quiet until it has seen this many of each class
BAYES_MIN_SPAM=10
BAYES_MIN_HAM=10
# random sample rate of clean messages learned as ham
BAYES_AUTO_HAM_RATE=0.02
# vocabulary cap — singleton tokens pruned beyond this (RAM)
BAYES_VOCAB_CAP=30000

# ---- Offboard LLM (OpenAI-compatible: Ollama, llama.cpp, LM Studio, vLLM) ---
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
# keep at 1 on a Pi 1 so you never run two inferences at once
LLM_MAX_WORKERS=1
LLM_MAX_QUEUE=32
LLM_MAX_TOKENS=200

# ---- Spam protection -------------------------------------------------------
SPAM_MAX_MESSAGES=6
SPAM_WINDOW_SECONDS=8
SPAM_DUPLICATE_LIMIT=3
SPAM_DUPLICATE_WINDOW=30
SPAM_MAX_MENTIONS=5
SPAM_MAX_LINKS=4
SPAM_MAX_EMOJI=15
SPAM_MAX_NEWLINES=20
SPAM_ACTION=timeout
SPAM_TIMEOUT_SECONDS=300

# ---- Raid / scam defense ---------------------------------------------------
RAID_ENABLED=true
RAID_JOIN_LIMIT=5
RAID_JOIN_WINDOW=20
RAID_MIN_ACCOUNT_AGE_HOURS=0
RAID_ACTION=lockdown
RAID_WARN_TO_MUTE=2
RAID_WARN_TO_KICK=3
RAID_WARN_TO_BAN=4
RAID_MUTE_SECONDS=3600
RAID_LINK_BLOCKLIST=

# ---- Ranking ---------------------------------------------------------------
RANK_ENABLED=true
RANK_XP_PER_MESSAGE=5
RANK_XP_COOLDOWN=60
RANK_XP_PER_REACTION=2
RANK_LEVEL_BASE=50
RANK_LEVEL_EXPONENT=1.6
RANK_REP_COOLDOWN=3600

# ---- Logging / record-keeping ----------------------------------------------
LOG_ENABLED=true
# Global fallback log channel id (per-server override: !set log.channel #chan)
LOG_CHANNEL_ID=
# Firehose: store EVERY message (heavy on SD/USB). Off by default.
LOG_MESSAGES=false
LOG_EDITS=true
LOG_DELETES=true
LOG_JOINS=true
LOG_LEAVES=true
LOG_MODERATION=true
# Auto-delete stored messages older than N days (privacy + disk). 0 = forever.
LOG_RETENTION_DAYS=30

# ---- Metrics (local HTTP + status file for Zabbix) -------------------------
METRICS_ENABLED=true
METRICS_HOST=127.0.0.1
METRICS_PORT=8085

# ---- Web dashboard (read-only; only on Pi 4/5 or a server) -----------------
WEBADMIN_ENABLED=false
WEBADMIN_HOST=0.0.0.0
WEBADMIN_PORT=8086
# required to view the dashboard; the wizard generates a random one
WEBADMIN_TOKEN=
WEBADMIN_PUBLIC_URL=

# ---- Email notifications (updates / restarts / alerts) ---------------------
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_FROM=
MAIL_TO=
MAIL_NOTIFY_ON_UPDATE=true
MAIL_NOTIFY_ON_START=false
