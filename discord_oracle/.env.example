# --- Required to run the Discord bot -------------------------------------
DISCORD_TOKEN=your-bot-token-here

# --- Optional -------------------------------------------------------------
# Command prefix for the management commands (!oracle start, etc.)
ORACLE_PREFIX=!

# Where the save file lives (each player's world persists here).
# ORACLE_DB=./discord_oracle/data/oracle.db

# The machine's hostname shown in-game.
# ORACLE_HOSTNAME=MERIDIAN-DC01

# --- LLM enrichment (ALL OPTIONAL — the game is fully playable with none) --
# The game never requires an LLM. These only make NPC conversations freeform.
#
# Option A: free, local — run Ollama (https://ollama.com), then:
#   ORACLE_LLM_BACKEND=ollama
#   ORACLE_OLLAMA_URL=http://localhost:11434
#   ORACLE_OLLAMA_MODEL=llama3.1
#
# Option B: paid API — set an Anthropic key (auto-selected if present):
#   ANTHROPIC_API_KEY=sk-ant-...
#   ORACLE_MODEL=claude-opus-4-8      # or claude-haiku-4-5 for cheaper chatter
#   ORACLE_LLM_MAX_TOKENS=1024
#
# Force it off explicitly (default when no key/backend is configured):
#   ORACLE_LLM_BACKEND=none
